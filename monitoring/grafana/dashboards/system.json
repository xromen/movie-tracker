    {
      "id": 8,
      "title": "Load на ядро",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "node_load1{job=\"node\"} / on (instance) count by (instance) (node_cpu_seconds_total{job=\"node\",mode=\"idle\"})",
          "legendFormat": "{{instance}} 1 мин",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "expr": "node_load5{job=\"node\"} / on (instance) count by (instance) (node_cpu_seconds_total{job=\"node\",mode=\"idle\"})",
          "legendFormat": "{{instance}} 5 мин",
          "refId": "B",
          "instant": false,
          "range": true
        },
        {
          "expr": "node_load15{job=\"node\"} / on (instance) count by (instance) (node_cpu_seconds_total{job=\"node\",mode=\"idle\"})",
          "legendFormat": "{{instance}} 15 мин",
          "refId": "C",
          "instant": false,
          "range": true
        }
      ],
      "description": "Load включает выполняемые процессы и процессы в непрерываемом ожидании; делится на число CPU-ядер.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
